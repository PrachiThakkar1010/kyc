# Copy this file to ".dev.vars" and fill in your own values.
# .dev.vars is private: it is listed in .gitignore and never uploaded.

# Supabase → Project Settings → API Keys (and Data API for the URL)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Cloudflare Turnstile (bot check). These are Cloudflare's official
# TEST keys, which always pass: fine on your computer, never in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
