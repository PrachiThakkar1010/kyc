---
// The horizontal road on the Story of the Day card.
// Dashed stretches and a hollow dashed circle mark a setback.
import type { Stop } from '../lib/types';
import { STOP_LABEL } from '../lib/format';

interface Props {
  stops: Pick<Stop, 'kind' | 'label' | 'place'>[];
}
const { stops } = Astro.props;

const rough = (i: number) => stops[i]?.kind === 'setback';
const items = stops.map((s, i) => ({
  kind: s.kind,
  label: s.label || STOP_LABEL[s.kind],
  left: i === 0 ? 'hidden' : rough(i) || rough(i - 1) ? 'rough' : 'solid',
  right: i === stops.length - 1 ? 'hidden' : rough(i) || rough(i + 1) ? 'rough' : 'solid',
}));
---

<div class="road" role="list" aria-label="Journey stops">
  {
    items.map((s) => (
      <div class="stop" role="listitem">
        <div class="track">
          <span class={`line ${s.left}`} />
          <span class={`dot ${s.kind}`} />
          <span class={`line ${s.right}`} />
        </div>
        <span class={`label ${s.kind}`}>{s.label}</span>
      </div>
    ))
  }
</div>

<style>
  .road { display: flex; padding: 14px 0 4px; }
  .stop { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .track { width: 100%; height: 22px; display: flex; align-items: center; }
  .line { flex: 1; height: 0; border-top: 3px solid var(--card-ink); }
  .line.hidden { border-color: transparent; }
  .line.rough { border-top-style: dashed; border-color: var(--card-road-dim); }
  .dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; background: var(--card-ink); }
  .dot.setback { width: 14px; height: 14px; background: var(--card); border: 2px dashed var(--card-road-dim); }
  .dot.podium { width: 22px; height: 22px; background: var(--gold); border: 4px solid var(--gold-bg); }
  .label {
    font-size: 12px;
    line-height: 1.3;
    text-align: center;
    color: var(--card-muted);
    overflow-wrap: anywhere;
    padding: 0 2px;
  }
  .label.setback { color: var(--card-road-dim); font-weight: 700; }
  .label.podium { color: var(--gold); font-weight: 700; }
</style>
