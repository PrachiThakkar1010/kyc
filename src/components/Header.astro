---
const path = Astro.url.pathname;
const active = (prefix: string) => (path.startsWith(prefix) ? 'page' : undefined);
---

<header class="site-header">
  <a href="/" class="brand" aria-label="KYC – Know Your Champions, home">
    <span class="brand-mark">KYC</span>
    <span class="brand-name">Know Your Champions</span>
  </a>

  <nav aria-label="Main">
    <a href="/stories" aria-current={active('/stories')}>Stories</a>
    <a href="/champions" aria-current={active('/champions')}>Champions</a>
  </nav>

  <button class="theme-toggle" type="button" aria-label="Switch between light and dark mode">
    <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
    </svg>
    <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </button>
</header>

<style>
  .site-header {
    height: 60px;
    padding: 0 8px 0 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--line);
  }
  .brand { display: flex; align-items: baseline; gap: 8px; text-decoration: none; color: var(--ink); margin-right: auto; }
  .brand-mark { font-size: 22px; font-weight: 700; letter-spacing: -0.5px; }
  .brand-name { font-size: 12px; color: var(--muted); }

  nav { display: flex; gap: 4px; }
  nav a {
    padding: 10px 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  nav a[aria-current='page'] { color: var(--accent-ink); text-decoration: underline; text-underline-offset: 6px; }

  .theme-toggle {
    width: 44px; height: 44px;
    border: 0; background: transparent; color: var(--ink);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
  .icon-sun { display: none; }
  :global([data-theme='dark']) .icon-sun { display: block; }
  :global([data-theme='dark']) .icon-moon { display: none; }

  /* Small phones: hide the long name, keep the links */
  @media (max-width: 420px) {
    .brand-name { display: none; }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>
