---
import type { Cheer } from '../lib/types';
import { prettyDate } from '../lib/format';
import { TURNSTILE_SITE_KEY } from 'astro:env/server';

interface Props {
  subject: 'champion' | 'team';
  subjectId: string;
  name: string;                               // who the wall is for
  cheers: Cheer[];
  members?: { id: string; name: string }[];   // team players who can be tagged
}
const { subject, subjectId, name, cheers, members = [] } = Astro.props;
const memberName = (id: string | null) => members.find((m) => m.id === id)?.name;
---

<section class="cheer-wall section" aria-labelledby="cheer-title" id="cheer">
  <h2 id="cheer-title">Cheer for {name}</h2>
  <p class="muted intro">Your message stays on this page, long after the story moves to the archive.</p>

  <form class="cheer-form" method="post" action="/api/cheer" novalidate>
    <input type="hidden" name="subject" value={subject} />
    <input type="hidden" name="subjectId" value={subjectId} />

    <label class="field">
      Your message
      <textarea name="message" rows="3" maxlength="280" required placeholder="Congratulations, champion. The whole country is proud of you."></textarea>
      <span class="hint"><span data-left>280</span> characters left</span>
    </label>

    <div class="row">
      <label class="field">
        Name
        <input type="text" name="name" maxlength="60" required autocomplete="given-name" placeholder="Riya" />
      </label>
      <label class="field">
        City <span class="hint">(optional)</span>
        <input type="text" name="city" maxlength="60" autocomplete="address-level2" placeholder="Guwahati" />
      </label>
    </div>

    {
      members.length > 0 && (
        <label class="field">
          For a particular player? <span class="hint">(optional)</span>
          <select name="tagged">
            <option value="">The whole team</option>
            {members.map((m) => (
              <option value={m.id}>{m.name}</option>
            ))}
          </select>
        </label>
      )
    }

    {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-size="flexible" />}

    <button type="submit" class="button-outline wide">Send cheer</button>
    <p class="notice" role="status" hidden></p>
  </form>

  <ul class="cheers">
    {
      cheers.map((c) => (
        <li class="cheer">
          <p class="message story-text">{c.message}</p>
          <p class="by small muted">
            {c.name}
            {c.city ? `, ${c.city}` : ''}
            {memberName(c.tagged_champion_id) ? ` · for ${memberName(c.tagged_champion_id)}` : ''}
            {' · '}
            {prettyDate(c.created_at.slice(0, 10))}
          </p>
          <button type="button" class="button-quiet report" data-id={c.id}>Report</button>
        </li>
      ))
    }
  </ul>
  {cheers.length === 0 && <p class="empty muted small">Be the first to send {name} a message.</p>}
</section>

<style>
  .intro { font-size: 14px; margin-top: 8px; }
  .cheer-form { margin-top: 16px; display: flex; flex-direction: column; gap: 14px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .cheers { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .cheer { padding: 16px; border-radius: 14px; background: var(--soft); display: flex; flex-direction: column; gap: 6px; }
  .message { font-size: 16px; line-height: 1.55; overflow-wrap: anywhere; }
  .report { align-self: flex-start; font-size: 12px; padding: 4px 0; }
  .empty { margin-top: 16px; }
</style>

<script>
  type Turnstile = { reset: (el?: Element) => void };

  document.querySelectorAll<HTMLFormElement>('.cheer-form').forEach((form) => {
    const notice = form.querySelector<HTMLElement>('.notice')!;
    const left = form.querySelector('[data-left]');
    const textarea = form.querySelector('textarea')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const list = form.closest('.cheer-wall')!.querySelector('.cheers')!;

    textarea.addEventListener('input', () => {
      if (left) left.textContent = String(280 - textarea.value.length);
    });

    function show(message: string, kind: 'ok' | 'error') {
      notice.hidden = false;
      notice.className = `notice ${kind}`;
      notice.textContent = message;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (!String(data.get('message') ?? '').trim() || !String(data.get('name') ?? '').trim()) {
        show('Write a message and your name first.', 'error');
        return;
      }
      submit.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const result = (await res.json()) as { ok: boolean; status?: string; error?: string; cheer?: { name: string; city: string | null; message: string } };
        if (!res.ok || !result.ok) {
          show(result.error ?? 'Your message could not be sent. Try again.', 'error');
        } else if (result.status === 'visible' && result.cheer) {
          const li = document.createElement('li');
          li.className = 'cheer';
          const p = document.createElement('p');
          p.className = 'message story-text';
          p.textContent = result.cheer.message;
          const by = document.createElement('p');
          by.className = 'by small muted';
          by.textContent = `${result.cheer.name}${result.cheer.city ? `, ${result.cheer.city}` : ''} · just now`;
          li.append(p, by);
          list.prepend(li);
          form.closest('.cheer-wall')?.querySelector('.empty')?.remove();
          form.reset();
          if (left) left.textContent = '280';
          show('Thank you. Your cheer is on the wall.', 'ok');
        } else {
          form.reset();
          show('Thank you. Your message will appear after a quick review.', 'ok');
        }
      } catch {
        show('Your message could not be sent. Check your connection and try again.', 'error');
      } finally {
        submit.disabled = false;
        const widget = form.querySelector('.cf-turnstile');
        const ts = (window as unknown as { turnstile?: Turnstile }).turnstile;
        if (widget && ts) ts.reset(widget);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.cheer .report').forEach((button) => {
    button.addEventListener('click', async () => {
      if (!confirm('Report this message as abusive or spam?')) return;
      button.disabled = true;
      await fetch('/api/report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cheerId: button.dataset.id }),
      }).catch(() => null);
      button.textContent = 'Reported. Thank you.';
    });
  });
</script>
