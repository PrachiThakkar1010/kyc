---
// A tiny version of a journey, used in story lists.
import type { MedalKind, StopKind } from '../lib/types';

interface Props {
  kinds: StopKind[];
  medal: MedalKind | null;
}
const { kinds, medal } = Astro.props;
const body = kinds.filter((k) => k !== 'podium').slice(0, 6);
---

<span class="mini" aria-hidden="true">
  {
    body.map((k) => (
      <>
        <span class={`dot ${k === 'setback' ? 'setback' : ''}`} />
        <span class={`line ${k === 'setback' ? 'setback' : ''}`} />
      </>
    ))
  }
  <span class={`end ${medal ?? ''}`} />
</span>

<style>
  .mini { display: flex; align-items: center; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .dot.setback { background: transparent; border: 2px dashed var(--setback); width: 10px; height: 10px; }
  .line { width: 20px; border-top: 2px solid var(--accent); }
  .line.setback { border-top-style: dashed; border-color: var(--setback); }
  .end { width: 12px; height: 12px; border-radius: 50%; background: var(--accent); }
  .end.gold { background: var(--gold); }
  .end.silver { background: var(--silver); }
  .end.bronze { background: var(--bronze); }
</style>
