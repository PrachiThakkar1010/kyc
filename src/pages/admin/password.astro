---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminClient } from '../../lib/supabase';
import { text } from '../../lib/http';

const profile = Astro.locals.profile;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = text(form, 'password', 200);
  const confirm = text(form, 'confirm', 200);
  if (password.length < 10) error = 'Use at least 10 characters.';
  else if (password !== confirm) error = 'The two passwords are different. Type them again.';
  else {
    const { error: authError } = await Astro.locals.supabase.auth.updateUser({ password });
    if (authError) error = authError.message;
    else {
      await adminClient().from('profiles').update({ must_change_password: false }).eq('id', profile.id);
      return Astro.redirect('/admin?msg=' + encodeURIComponent('Password changed. Welcome to KYC.'));
    }
  }
}
---

<AdminLayout title="Choose your password">
  <section class="admin-page narrow">
    <h1>{profile.must_change_password ? 'Choose your own password' : 'Change your password'}</h1>
    {profile.must_change_password && <p class="muted">You logged in with a temporary password. Choose a new one that only you know.</p>}
    {error && <p class="notice error" role="alert">{error}</p>}
    <form method="post" class="stack">
      <label class="field">New password <span class="hint">At least 10 characters</span>
        <input type="password" name="password" required minlength="10" autocomplete="new-password" />
      </label>
      <label class="field">Type it again <input type="password" name="confirm" required minlength="10" autocomplete="new-password" /></label>
      <button type="submit" class="button">Save password</button>
    </form>
  </section>
</AdminLayout>

<style>
  .narrow { max-width: 420px; }
</style>
