---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { photoUrl } from '../../../lib/supabase';
import { friendlyError, uniqueSlug, withMessage } from '../../../lib/admin';
import { removePhotos, uploadPhoto } from '../../../lib/upload';
import { isUuid, optional, text } from '../../../lib/http';
import { MEDAL_LABEL, prettyDate } from '../../../lib/format';
import type { Champion, Medal } from '../../../lib/types';

const db = Astro.locals.supabase;
const id = Astro.params.id ?? '';
if (!isUuid(id)) return Astro.redirect('/admin/champions');
const here = `/admin/champions/${id}`;

const { data: found } = await db.from('champions').select('*').eq('id', id).maybeSingle();
if (!found) return Astro.redirect(withMessage('/admin/champions', 'That champion no longer exists.', 'error'));
const champion = found as Champion;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = text(form, 'action');
  try {
    if (action === 'save') {
      const name = text(form, 'name', 120);
      const sport = text(form, 'sport', 80);
      if (!name || !sport) throw new Error('Name and sport are needed.');
      let photoPath = champion.photo_path;
      const uploaded = await uploadPhoto(db, form.get('photo'), `champions/${id}`);
      if (uploaded || form.get('remove_photo') === '1') {
        await removePhotos(db, [photoPath]);
        photoPath = uploaded;
      }
      const slug = await uniqueSlug(db, 'champions', text(form, 'slug', 80) || name, id);
      const { error: e } = await db.from('champions').update({
        name, sport, slug,
        state: optional(form, 'state', 80),
        hometown: optional(form, 'hometown', 120),
        bio: optional(form, 'bio', 4000),
        photo_path: photoPath,
        photo_credit: optional(form, 'photo_credit', 120),
      }).eq('id', id);
      if (e) throw new Error(friendlyError(e));
      return Astro.redirect(withMessage(here, 'Saved.'));
    }
    if (action === 'add_medal') {
      const medal = text(form, 'medal');
      if (!['gold', 'silver', 'bronze'].includes(medal)) throw new Error('Choose gold, silver or bronze.');
      const event = text(form, 'event', 160);
      if (!event) throw new Error('Write the event name.');
      const { error: e } = await db.from('medals').insert({
        medal, event, champion_id: id,
        sport: text(form, 'sport', 80) || champion.sport,
        won_on: text(form, 'won_on') || null,
      });
      if (e) throw new Error(friendlyError(e));
      return Astro.redirect(withMessage(here, 'Medal added.'));
    }
    if (action === 'delete_medal') {
      const { error: e } = await db.from('medals').delete().eq('id', text(form, 'medal_id')).eq('champion_id', id);
      if (e) throw new Error(friendlyError(e));
      return Astro.redirect(withMessage(here, 'Medal removed.'));
    }
    if (action === 'delete') {
      const { error: e } = await db.from('champions').delete().eq('id', id);
      if (e) throw new Error(friendlyError(e));
      await removePhotos(db, [champion.photo_path]);
      return Astro.redirect(withMessage('/admin/champions', `${champion.name} deleted.`));
    }
  } catch (e) {
    error = e instanceof Error ? e.message : 'Something went wrong.';
  }
}

const [{ data: medals }, { data: teams }, { data: stories }] = await Promise.all([
  db.from('medals').select('*').eq('champion_id', id),
  db.from('team_members').select('team:teams(id, name)').eq('champion_id', id),
  db.from('stories').select('id, headline, status').eq('champion_id', id),
]);
---

<AdminLayout title={champion.name} wide>
  <section class="admin-page">
    <div class="actions" style="justify-content: space-between">
      <h1>{champion.name}</h1>
      <div class="actions">
        <a class="button-outline" href={`/champions/${champion.slug}`} target="_blank" rel="noopener">View page</a>
        <a class="button" href={`/admin/stories/new?for=c:${id}`}>Write their story</a>
      </div>
    </div>
    {error && <p class="notice error" role="alert">{error}</p>}

    {
      (stories ?? []).length > 0 && (
        <p class="small">Stories: {(stories ?? []).map((s, i) => (<>{i > 0 && ', '}<a href={`/admin/stories/${s.id}`}>{s.headline}</a> <span class={`tag ${s.status}`}>{s.status}</span></>))}</p>
      )
    }

    <form method="post" enctype="multipart/form-data" class="panel">
      <input type="hidden" name="action" value="save" />
      <div class="two">
        <label class="field">Full name <input type="text" name="name" required maxlength="120" value={champion.name} /></label>
        <label class="field">Sport <input type="text" name="sport" required maxlength="80" value={champion.sport} /></label>
        <label class="field">State <input type="text" name="state" maxlength="80" value={champion.state ?? ''} /></label>
        <label class="field">Hometown <input type="text" name="hometown" maxlength="120" value={champion.hometown ?? ''} /></label>
      </div>
      <label class="field">Short profile <span class="hint">Shown on their page. Leave a blank line between paragraphs.</span>
        <textarea name="bio" rows="5" maxlength="4000">{champion.bio ?? ''}</textarea>
      </label>
      <div class="two">
        <div class="field">
          Photo
          {champion.photo_path && (
            <div class="actions">
              <img class="thumb" src={photoUrl(champion.photo_path)} alt="" />
              <label class="small"><input type="checkbox" name="remove_photo" value="1" /> Remove</label>
            </div>
          )}
          <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" />
        </div>
        <label class="field">Photo credit <input type="text" name="photo_credit" maxlength="120" value={champion.photo_credit ?? ''} /></label>
      </div>
      <label class="field">Web address <span class="hint">/champions/...</span>
        <input type="text" name="slug" maxlength="80" pattern="[a-z0-9\-]*" value={champion.slug} />
      </label>
      <button type="submit" class="button">Save</button>
    </form>

    <div class="panel">
      <h2>Individual medals</h2>
      {(medals ?? []).length === 0 && <p class="small muted">None. Team medals are added on the team's page.</p>}
      <ul class="plain">
        {((medals ?? []) as Medal[]).map((m) => (
          <li class="actions">
            <span class={`medal-pill ${m.medal}`}><span class={`medal-dot ${m.medal}`} />{MEDAL_LABEL[m.medal]}</span>
            <span>{m.sport}, {m.event}{m.won_on ? `, ${prettyDate(m.won_on)}` : ''}</span>
            <form method="post" class="inline" data-confirm="Remove this medal?">
              <input type="hidden" name="action" value="delete_medal" />
              <input type="hidden" name="medal_id" value={m.id} />
              <button type="submit" class="button-quiet">Remove</button>
            </form>
          </li>
        ))}
      </ul>
      <form method="post" class="stack">
        <input type="hidden" name="action" value="add_medal" />
        <div class="two">
          <label class="field">Medal
            <select name="medal"><option value="gold">Gold</option><option value="silver">Silver</option><option value="bronze">Bronze</option></select>
          </label>
          <label class="field">Event <input type="text" name="event" required maxlength="160" placeholder="Women's 75 kg" /></label>
          <label class="field">Sport <input type="text" name="sport" maxlength="80" value={champion.sport} /></label>
          <label class="field">Date won <input type="date" name="won_on" /></label>
        </div>
        <button type="submit" class="button-outline">Add medal</button>
      </form>
    </div>

    {
      (teams ?? []).length > 0 && (
        <div class="panel">
          <h2>Teams</h2>
          <ul class="plain">
            {(teams ?? []).map((t) => {
              const team = t.team as unknown as { id: string; name: string };
              return <li><a href={`/admin/teams/${team.id}`}>{team.name}</a></li>;
            })}
          </ul>
        </div>
      )
    }

    <form method="post" data-confirm={`Delete ${champion.name}, their medals, stories and cheers? This cannot be undone.`}>
      <input type="hidden" name="action" value="delete" />
      <button type="submit" class="button button-danger">Delete champion</button>
    </form>
  </section>
</AdminLayout>

<style>
  .plain { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
</style>
