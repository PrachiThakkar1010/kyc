---
// Every medal India won, grouped into gold, silver and bronze.
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import { publicClient } from '../lib/supabase';
import { getAllMedals, getTally, getTeamRosters } from '../lib/data';
import { MEDAL_LABEL, prettyDate } from '../lib/format';
import type { MedalKind } from '../lib/types';

const db = publicClient();
const [medals, tally, rosters] = await Promise.all([getAllMedals(db), getTally(db), getTeamRosters(db)]);
const kinds: MedalKind[] = ['gold', 'silver', 'bronze'];
const sportsCount = new Set(medals.map((m) => m.sport)).size;

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<BaseLayout title="All medals" description={`All ${tally.total} medals India won at the Aichi-Nagoya 2026 Asian Games.`}>
  <header class="head">
    <p class="kicker">Aichi-Nagoya 2026 Asian Games</p>
    <h1>All {tally.total} medals</h1>
    <p class="muted lead">
      Won across {sportsCount} sports{tally.asOf ? `, as of ${tally.asOf}` : ''}. Tap any name to meet the champion behind the medal.
    </p>

    <!-- Jump links: tap a medal to scroll to its list -->
    <nav class="jump" aria-label="Jump to a medal">
      {
        kinds.map((k) => (
          <a href={`#${k}`} class={`jump-box ${k}`}>
            <span class={`big-medal ${k}`} aria-hidden="true" />
            <span class="jump-count">{tally.counts[k]}</span>
            <span class="jump-label">{MEDAL_LABEL[k]}</span>
          </a>
        ))
      }
    </nav>
  </header>

  {
    kinds.map((k) => {
      const list = medals.filter((m) => m.medal === k);
      // Individual medals first, then team medals
      const parts = [
        { label: 'Individual', items: list.filter((m) => !m.team) },
        { label: 'Team ', items: list.filter((m) => m.team) },
      ];
      return (
        <section class={`group ${k}`} id={k} aria-labelledby={`${k}-title`}>
          <div class="group-head">
            <span class={`big-medal ${k}`} aria-hidden="true" />
            <h2 id={`${k}-title`}>{MEDAL_LABEL[k]}</h2>
            <span class="group-count">{list.length}</span>
          </div>

          {parts.map((part) => part.items.length > 0 && (
            <div class="part">
              <h3 class="part-title">
                {part.label}
                <span class="part-count">{part.items.length}</span>
              </h3>
              <ul class="cards">
                {part.items.map((m) => {
                  // ---- Team medal: team name, then its players ----
                  if (m.team) {
                    const players = rosters.get(m.team_id!) ?? [];
                    return (
                      <li>
                        <div class="card team-card">
                          <div class="card-top">
                            <Avatar name={m.team.name} path={m.team.photo_path} size={48} />
                            <span class="card-text">
                              <a href={`/teams/${m.team.slug}`} class="name team-link">{m.team.name}</a>
                              <span class="event">{m.event}</span>
                              <span class="meta">
                                <span class="sport">{m.sport}</span>
                                {m.won_on && <span class="date">{prettyDate(m.won_on)}</span>}
                              </span>
                            </span>
                          </div>

                          {players.length > 0 ? (
                            <details class="roster">
                              <summary>
                                {players.length} {players.length === 1 ? 'champion' : 'champions'}
                                <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                              </summary>
                              <ul class="players">
                                {players.map((p) => (
                                  <li>
                                    <a href={p.href} class="player">
                                      <span>{p.name}</span>
                                      <span class:list={['player-tag', { ready: p.hasStory }]}>
                                        {p.hasStory ? 'Read story' : 'Story soon'}
                                      </span>
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </details>
                          ) : (
                            <p class="roster-empty">Squad list coming soon</p>
                          )}
                          <span class={`ribbon ${k}`} aria-hidden="true" />
                        </div>
                      </li>
                    );
                  }

                  // ---- Individual medal: the whole card links to the champion ----
                  const who = m.champion;
                  return (
                    <li>
                      <a href={`/champions/${who?.slug}`} class="card">
                        <Avatar name={who?.name ?? ''} path={who?.photo_path ?? null} size={48} />
                        <span class="card-text">
                          <span class="name">{who?.name}</span>
                          <span class="event">{m.event}</span>
                          <span class="meta">
                            <span class="sport">{m.sport}</span>
                            {m.won_on && <span class="date">{prettyDate(m.won_on)}</span>}
                          </span>
                        </span>
                        <span class={`ribbon ${k}`} aria-hidden="true" />
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </section>
      );
    })
  }
</BaseLayout>

<style>
  /* ---------- Top of the page ---------- */
  .head { padding-top: 32px; display: flex; flex-direction: column; gap: 12px; }
  .kicker { font-size: 13px; font-weight: 700; color: var(--accent-ink); }
  .lead { font-size: 16px; line-height: 1.5; max-width: 52ch; }

  .jump { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 12px; }
  .jump-box {
    padding: 16px 14px;
    border-radius: 18px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform 0.15s;
  }
  .jump-box:hover { transform: translateY(-2px); }
  .jump-box.gold   { background: var(--gold-bg);   color: var(--gold-ink); }
  .jump-box.silver { background: var(--silver-bg); color: var(--silver-ink); }
  .jump-box.bronze { background: var(--bronze-bg); color: var(--bronze-ink); }
  .jump-count { font-size: 34px; font-weight: 700; line-height: 1; }
  .jump-label { font-size: 14px; font-weight: 600; }

  /* A round medal with an inner ring, in the medal's colour */
  .big-medal {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: inset 0 0 0 4px rgba(255, 255, 255, 0.35);
  }
  .big-medal.gold   { background: var(--gold); }
  .big-medal.silver { background: var(--silver); }
  .big-medal.bronze { background: var(--bronze); }

  /* ---------- Each medal group ---------- */
  .group { margin-top: 48px; scroll-margin-top: 90px; }
  .group-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 14px;
    margin-bottom: 16px;
    border-bottom: 3px solid var(--line);
  }
  .group.gold .group-head   { border-color: var(--gold); }
  .group.silver .group-head { border-color: var(--silver); }
  .group.bronze .group-head { border-color: var(--bronze); }
  .group-head .big-medal { width: 32px; height: 32px; }
  .group-count {
    margin-left: auto;
    min-width: 40px;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
    text-align: center;
  }
  .gold .group-count   { background: var(--gold-bg);   color: var(--gold-ink); }
  .silver .group-count { background: var(--silver-bg); color: var(--silver-ink); }
  .bronze .group-count { background: var(--bronze-bg); color: var(--bronze-ink); }

  /* ---------- Individual / Team sub-sections ---------- */
  .part + .part { margin-top: 28px; }
  .part-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .part-count {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--soft);
    font-size: 12px;
    letter-spacing: 0;
  }

  /* ---------- Medal cards ---------- */
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 10px; align-items: start; }
  .card {
    position: relative;
    overflow: hidden;
    height: 100%;
    padding: 14px 16px 14px 18px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 14px;
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover { border-color: var(--accent); transform: translateY(-2px); }

  /* A thin strip of medal colour on the left edge of each card */
  .ribbon { position: absolute; left: 0; top: 0; bottom: 0; width: 5px; }
  .ribbon.gold   { background: var(--gold); }
  .ribbon.silver { background: var(--silver); }
  .ribbon.bronze { background: var(--bronze); }

  .card-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .name { font-size: 16px; font-weight: 700; line-height: 1.25; }
  .event { font-size: 14px; color: var(--ink); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: 12px; color: var(--muted); }

  /* ---------- Team medal cards ---------- */
  .team-card { flex-direction: column; align-items: stretch; gap: 10px; }
  .team-card:hover { transform: none; }
  .card-top { display: flex; align-items: center; gap: 14px; }
  .team-link { color: var(--ink); text-decoration: none; }
  .team-link:hover { color: var(--accent-ink); text-decoration: underline; text-underline-offset: 3px; }

  .roster { border-top: 1px solid var(--line); padding-top: 8px; }
  .roster summary {
    list-style: none;
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-ink);
    cursor: pointer;
  }
  .roster summary::-webkit-details-marker { display: none; }
  .chevron { transition: transform 0.2s; }
  .roster[open] .chevron { transform: rotate(180deg); }

  .players { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; }
  .player {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 6px 10px;
    border-radius: 10px;
    color: var(--ink);
    text-decoration: none;
    font-size: 15px;
  }
  .player:hover { background: var(--soft); }
  .player-tag { flex-shrink: 0; font-size: 12px; font-weight: 600; color: var(--muted); }
  .player-tag.ready { color: var(--accent-ink); }
  .roster-empty { border-top: 1px solid var(--line); padding-top: 10px; font-size: 13px; color: var(--muted); }

  @media (min-width: 640px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  }
  @media (min-width: 960px) {
    .head { padding-top: 48px; }
    .jump { max-width: 640px; gap: 14px; }
    .jump-box { padding: 20px 18px; }
    .jump-count { font-size: 40px; }
    .group { margin-top: 64px; }
    .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  }
</style>