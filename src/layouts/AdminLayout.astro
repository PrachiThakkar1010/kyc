---
import '../styles/global.css';

interface Props {
  title: string;
  wide?: boolean;
}
const { title, wide = false } = Astro.props;
const profile = Astro.locals.profile;
const path = Astro.url.pathname;
const msg = Astro.url.searchParams.get('msg');
const err = Astro.url.searchParams.get('error');

const links = [
  { href: '/admin', label: 'Stories' },
  { href: '/admin/champions', label: 'Champions' },
  { href: '/admin/cheers', label: 'Cheers' },
  { href: '/admin/feedback', label: 'Feedback' },
  { href: '/admin/settings', label: 'Settings' },
  ...(profile?.role === 'admin' ? [{ href: '/admin/writers', label: 'Writers' }] : []),
];
const isActive = (href: string) =>
  href === '/admin' ? path === '/admin' || path.startsWith('/admin/stories') : path.startsWith(href) || (href === '/admin/champions' && path.startsWith('/admin/teams'));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | KYC writer panel</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;700&family=Literata:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <header class="admin-header">
      <a href="/admin" class="brand"><strong>KYC</strong> <span class="muted">writer panel</span></a>
      {
        profile && (
          <div class="who">
            <span class="small muted">{profile.display_name}</span>
            <a href="/" class="small" target="_blank" rel="noopener">View site</a>
            <form method="post" action="/admin/logout">
              <button type="submit" class="button-quiet">Log out</button>
            </form>
          </div>
        )
      }
    </header>
    {
      profile && !profile.must_change_password && (
        <nav class="admin-nav" aria-label="Writer panel">
          {links.map((l) => (
            <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
          ))}
        </nav>
      )
    }
    <main class:list={{ wide }}>
      {msg && <p class="notice ok flash" role="status">{msg}</p>}
      {err && <p class="notice error flash" role="alert">{err}</p>}
      <slot />
    </main>

    <script>
      // Shrink photos in the browser before upload: faster for writers on
      // mobile data, and lighter pages for visitors.
      const MAX = 1600;
      document.addEventListener('change', async (event) => {
        const input = event.target as HTMLInputElement;
        if (input.type !== 'file' || !input.files?.[0] || !input.accept.includes('image')) return;
        const file = input.files[0];
        if (!file.type.startsWith('image/') || file.type === 'image/gif') return;
        try {
          const bitmap = await createImageBitmap(file);
          const scale = Math.min(1, MAX / Math.max(bitmap.width, bitmap.height));
          const canvas = document.createElement('canvas');
          canvas.width = Math.round(bitmap.width * scale);
          canvas.height = Math.round(bitmap.height * scale);
          canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
          const blob = await new Promise<Blob | null>((r) => canvas.toBlob(r, 'image/jpeg', 0.82));
          if (!blob || blob.size >= file.size) return;
          const smaller = new File([blob], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' });
          const transfer = new DataTransfer();
          transfer.items.add(smaller);
          input.files = transfer.files;
        } catch {
          /* keep the original file */
        }
      });

      // Ask before destructive actions.
      document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
        form.addEventListener('submit', (e) => {
          if (!confirm(form.dataset.confirm)) e.preventDefault();
        });
      });

      // Prevent double submits and show progress.
      document.querySelectorAll<HTMLFormElement>('form').forEach((form) => {
        form.addEventListener('submit', (e) => {
          if (e.defaultPrevented) return;
          const btn = (e as SubmitEvent).submitter as HTMLButtonElement | null;
          if (btn) setTimeout(() => (btn.disabled = true), 0);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  .admin-header {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    padding: 12px 20px; border-bottom: 1px solid var(--line);
  }
  .admin-header .brand { color: var(--ink); text-decoration: none; font-size: 18px; }
  .admin-header .who { display: flex; align-items: center; gap: 14px; }
  .admin-nav {
    display: flex; gap: 4px; overflow-x: auto;
    padding: 0 12px; border-bottom: 1px solid var(--line);
  }
  .admin-nav a {
    padding: 12px 10px; font-size: 14px; font-weight: 600;
    color: var(--muted); text-decoration: none; white-space: nowrap;
    border-bottom: 3px solid transparent;
  }
  .admin-nav a[aria-current='page'] { color: var(--ink); border-color: var(--accent); }
  main.wide { max-width: 960px; }
  .flash { margin-top: 16px; }
  .admin-page { padding-top: 24px; display: flex; flex-direction: column; gap: 20px; }
  .admin-page h1 { font-size: 28px; }
  .panel { padding: 18px; border-radius: 14px; border: 1px solid var(--line); display: flex; flex-direction: column; gap: 14px; }
  .stack { display: flex; flex-direction: column; gap: 14px; }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .table th, .table td { text-align: left; padding: 10px 8px; border-top: 1px solid var(--line); vertical-align: top; }
  .table th { font-size: 12px; color: var(--muted); font-weight: 600; border-top: 0; }
  .table-wrap { overflow-x: auto; }
  .tag { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; background: var(--soft); color: var(--muted); }
  .tag.published, .tag.visible, .tag.resolved { background: var(--ok-bg); color: var(--ok); }
  .tag.pending, .tag.new { background: var(--gold-bg); color: var(--gold-ink); }
  .tag.hidden { background: var(--danger-bg); color: var(--danger); }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .inline { display: inline; }
  .thumb { width: 120px; height: 80px; object-fit: cover; border-radius: 8px; }
</style>
